# AI Providers (set only those you use; none required for local-only mode)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Local inference via Ollama (no key needed; install Ollama first)
OLLAMA_BASE_URL=http://localhost:11434

# Default model configuration
# Options: ollama, openai, google, anthropic
DEFAULT_VISION_PROVIDER=ollama
DEFAULT_VISION_MODEL=llama3.2-vision:11b
DEFAULT_TEXT_PROVIDER=ollama
DEFAULT_TEXT_MODEL=mistral:7b

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/mech_cad.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mech_cad

# Artifact storage
ARTIFACT_STORE_PATH=./data/artifacts
ARTIFACT_STORE_BACKEND=local
# ARTIFACT_STORE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=mech-cad-artifacts
# AWS_S3_REGION=us-east-1

# Redis (for job queue)
REDIS_URL=redis://localhost:6379/0

# API security
AUTH_DISABLED=true
API_SECRET_KEY=change-this-in-production-use-long-random-string

# Pipeline limits
JOB_TIMEOUT_SECONDS=600
CAD_EXEC_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=52428800
MAX_CONCURRENT_JOBS=4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
